#!/bin/sh
# Resolves the two static archives that LinkingTo cannot point at.
#
# LinkingTo gets the *headers* onto the include path by itself. There is no
# equivalent for a library, and the alternatives are worse: $(shell ...) in
# Makevars would force SystemRequirements: GNU make, and an Imports: entry
# would add a runtime dependency the design does not want -- nothing in
# zuxlsx calls R code in zuxml or zukomp, and the archives are linked in
# statically, so neither package needs to be loadable at run time.
set -eu

: "${R_HOME:?configure must be run by R CMD INSTALL, which sets R_HOME}"
RSCRIPT="${R_HOME}/bin/Rscript"

# Where a sibling installed its static archive.
#
# zukomp installs under R_ARCH, so on Windows the archive is in lib/x64 rather
# than lib; zuxml still installs to a plain lib. R_ARCH is empty on every
# single-arch platform, which is all of them except Windows since R 4.2
# dropped 32-bit builds, so the two spellings coincide everywhere else and the
# difference only shows up on the one platform.
#
# Asking for the arch-specific path first and falling back to the plain one is
# correct for either convention, and stays correct when the siblings agree
# again -- which matters because this is resolved at install time against
# whatever version of them happens to be installed.
lib_dir() {
  "${RSCRIPT}" --vanilla -e "arch <- .Platform\$r_arch; d <- if (nzchar(arch)) system.file('lib', arch, package = '$1') else ''; if (!nzchar(d)) d <- system.file('lib', package = '$1'); cat(d)"
}

fail() {
  echo "configure: $1/lib/$2 was not found." >&2
  echo "" >&2
  echo "  zuxlsx links it statically. It ships with $1 0.1.0 and later;" >&2
  echo "  an older installed $1 does not have it. Reinstall with:" >&2
  echo "" >&2
  echo "    pak::pak(\"pedrobtz/$1\")" >&2
  exit 1
}

ZUXML_LIB=$(lib_dir zuxml)
ZUKOMP_LIB=$(lib_dir zukomp)

[ -n "${ZUXML_LIB}" ] && [ -f "${ZUXML_LIB}/libzuxml.a" ] || fail zuxml libzuxml.a
[ -n "${ZUKOMP_LIB}" ] && [ -f "${ZUKOMP_LIB}/libzukomp.a" ] || fail zukomp libzukomp.a

sed \
  -e "s|@ZUXML_LIB@|${ZUXML_LIB}|g" \
  -e "s|@ZUKOMP_LIB@|${ZUKOMP_LIB}|g" \
  src/Makevars.in > src/Makevars

echo "configure: linking ${ZUXML_LIB}/libzuxml.a and ${ZUKOMP_LIB}/libzukomp.a"
