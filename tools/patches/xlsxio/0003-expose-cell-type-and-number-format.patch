+/* zuxlsx: xl/styles.xml, reduced to the one question a reader must ask of it.
+   OOXML stores a date as an ordinary number; the number format attached to
+   the cell is the only thing that says it is a date. Upstream locates the
+   styles part and then frees the name without opening it, so that
+   information was simply absent.
+
+   Two tables are needed. cellXfs maps a cell's s= index to a numFmtId, and
+   numFmts declares the format codes for ids at or above 164; below that the
+   ids are built in and carry no code. */
+struct numfmt_table {
+  int* xf;                 //numFmtId per cellXfs entry, in document order
+  size_t xf_count;
+  size_t xf_size;
+  int* custom_id;          //ids declared in <numFmts>
+  int* custom_isdate;
+  size_t custom_count;
+  size_t custom_size;
+  int in_cellxfs;          //<xf> appears in cellStyleXfs too; only cellXfs counts
+  int oom;
+};
+
+/* Does a format code describe a date or a time?
+   Literal text in quotes, backslash escapes and bracketed sections such as
+   [Red] must not be scanned: "day" is text, [h] is elapsed hours. */
+static int numfmt_code_is_date (const XML_Char* code)
+{
+  const XML_Char* p = code;
+  if (!p)
+    return 0;
+  while (*p) {
+    if (*p == '"') {
+      for (p++; *p && *p != '"'; p++) ;
+      if (*p) p++;
+    } else if (*p == '\\') {
+      p++;
+      if (*p) p++;
+    } else if (*p == '[') {
+      const XML_Char* q = p + 1;
+      int elapsed = 0;
+      for (; *q && *q != ']'; q++)
+        if (*q == 'h' || *q == 'H' || *q == 'm' || *q == 'M' || *q == 's' || *q == 'S')
+          elapsed = 1;
+      if (elapsed)
+        return 1;
+      p = (*q ? q + 1 : q);
+    } else {
+      switch (*p) {
+        case 'y': case 'Y': case 'd': case 'D':
+        case 'h': case 'H': case 's': case 'S':
+          return 1;
+        case 'm': case 'M':
+          //month or minute; either way the cell is a date or a time
+          return 1;
+        default:
+          break;
+      }
+      p++;
+    }
+  }
+  return 0;
+}
+
+/* Built-in ids with date or time semantics, per ECMA-376 part 1, 18.8.30. */
+static int numfmt_builtin_is_date (int id)
+{
+  return (id >= 14 && id <= 22) || (id >= 45 && id <= 47);
+}
+
+static struct numfmt_table* numfmt_table_create (void)
+{
+  struct numfmt_table* t = (struct numfmt_table*)malloc(sizeof(struct numfmt_table));
+  if (!t)
+    return NULL;
+  t->xf = NULL; t->xf_count = 0; t->xf_size = 0;
+  t->custom_id = NULL; t->custom_isdate = NULL;
+  t->custom_count = 0; t->custom_size = 0;
+  t->in_cellxfs = 0; t->oom = 0;
+  return t;
+}
+
+static void numfmt_table_destroy (struct numfmt_table* t)
+{
+  if (!t)
+    return;
+  free(t->xf);
+  free(t->custom_id);
+  free(t->custom_isdate);
+  free(t);
+}
+
+/* Is the cell carrying style index `style` formatted as a date? */
+int numfmt_table_style_is_date (const struct numfmt_table* t, long style)
+{
+  int id;
+  size_t i;
+  if (!t || style < 0 || (size_t)style >= t->xf_count)
+    return 0;
+  id = t->xf[style];
+  for (i = 0; i < t->custom_count; i++)
+    if (t->custom_id[i] == id)
+      return t->custom_isdate[i];
+  return numfmt_builtin_is_date(id);
+}
+
+static void numfmt_expat_callback_element_start (void* callbackdata, const XML_Char* name, const XML_Char** atts)
+{
+  struct numfmt_table* t = (struct numfmt_table*)callbackdata;
+  if (XML_Char_icmp_ins(name, X("cellXfs")) == 0) {
+    t->in_cellxfs = 1;
+  } else if (t->in_cellxfs && XML_Char_icmp_ins(name, X("xf")) == 0) {
+    const XML_Char* a = get_expat_attr_by_name(atts, X("numFmtId"));
+    XML_Char* endp = NULL;
+    if (t->xf_count == t->xf_size) {
+      size_t size = (t->xf_size < 16 ? 16 : t->xf_size * 2);
+      int* grown;
+      if (size > SIZE_MAX / sizeof(int)) { t->oom = 1; return; }
+      if ((grown = (int*)realloc(t->xf, size * sizeof(int))) == NULL) { t->oom = 1; return; }
+      t->xf = grown;
+      t->xf_size = size;
+    }
+    t->xf[t->xf_count++] = (a ? (int)XML_Char_strtol(a, &endp, 10) : 0);
+  } else if (XML_Char_icmp_ins(name, X("numFmt")) == 0) {
+    const XML_Char* a = get_expat_attr_by_name(atts, X("numFmtId"));
+    const XML_Char* c = get_expat_attr_by_name(atts, X("formatCode"));
+    XML_Char* endp = NULL;
+    if (t->custom_count == t->custom_size) {
+      size_t size = (t->custom_size < 8 ? 8 : t->custom_size * 2);
+      int* gi;
+      int* gd;
+      if (size > SIZE_MAX / sizeof(int)) { t->oom = 1; return; }
+      if ((gi = (int*)realloc(t->custom_id, size * sizeof(int))) == NULL) { t->oom = 1; return; }
+      t->custom_id = gi;
+      if ((gd = (int*)realloc(t->custom_isdate, size * sizeof(int))) == NULL) { t->oom = 1; return; }
+      t->custom_isdate = gd;
+      t->custom_size = size;
+    }
+    t->custom_id[t->custom_count] = (a ? (int)XML_Char_strtol(a, &endp, 10) : 0);
+    t->custom_isdate[t->custom_count] = numfmt_code_is_date(c);
+    t->custom_count++;
+  }
+}
 
+static void numfmt_expat_callback_element_end (void* callbackdata, const XML_Char* name)
+{
+  struct numfmt_table* t = (struct numfmt_table*)callbackdata;
+  if (XML_Char_icmp_ins(name, X("cellXfs")) == 0)
+    t->in_cellxfs = 0;
+}
