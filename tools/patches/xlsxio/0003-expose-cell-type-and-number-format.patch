+/* zuxlsx: the OOXML type and date-ness of the cell most recently returned by
+   xlsxioread_sheet_next_cell(). Both describe that cell only, and are reset
+   when the next one is read. */
+DLL_EXPORT_XLSXIO int xlsxioread_sheet_last_cell_type (xlsxioreadersheet sheethandle)
+{
+  if (!sheethandle)
+    return XLSXIOREAD_CELLTYPE_NONE;
+  switch (sheethandle->processcallbackdata.last_cell_type) {
+    case value_string:   return XLSXIOREAD_CELLTYPE_NUMBER;
+    case inline_string:  return XLSXIOREAD_CELLTYPE_STRING;
+    case shared_string:  return XLSXIOREAD_CELLTYPE_STRING;
+    case boolean_string: return XLSXIOREAD_CELLTYPE_BOOLEAN;
+    case error_string:   return XLSXIOREAD_CELLTYPE_ERROR;
+    case formula_string: return XLSXIOREAD_CELLTYPE_STRING;
+    case date_string:    return XLSXIOREAD_CELLTYPE_DATE;
+    default:             return XLSXIOREAD_CELLTYPE_NONE;
+  }
 }
 
+DLL_EXPORT_XLSXIO int xlsxioread_sheet_last_cell_is_date (xlsxioreadersheet sheethandle)
+{
+  if (!sheethandle)
+    return 0;
+  if (sheethandle->processcallbackdata.last_cell_type == date_string)
+    return 1;
+  //an ISO date carries t="d"; everything else is a number plus a format
+  if (sheethandle->processcallbackdata.last_cell_type != value_string)
+    return 0;
+  return numfmt_table_style_is_date(sheethandle->processcallbackdata.numfmts,
+                                    sheethandle->processcallbackdata.last_cell_style);
+}
